{
  "name": "graphql-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:mutations": "tsx --env-file=.env scripts/test-mutations.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "backfill:owner-id": "tsx --env-file=.env scripts/backfill-owner-id.ts",
    "backfill:models": "tsx --env-file=.env scripts/backfill-models.ts",
    "move:sound-snapshots": "tsx --env-file=.env scripts/move-sound-snapshots.ts",
    "api-client": "tsx --env-file=.env scripts/api-clients.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-relay": "^4.8.1",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "better-auth": "^1.7.12",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "mongoose": "^9.11.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "better-call": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "type": "module"
}

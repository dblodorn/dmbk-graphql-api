#!/bin/sh
# Typecheck before every commit (src/ and scripts/). Bypass with --no-verify;
# CI runs the same check before deploying, so a bypass can't reach production.
# Installed by `npm install` (the `prepare` script sets core.hooksPath).
echo "pre-commit: npm run typecheck"
npm run -s typecheck || {
  echo "pre-commit: typecheck failed; commit aborted." >&2
  exit 1
}
